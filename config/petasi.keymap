#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        Base {
            bindings = <
  &kp SINGLE_QUOTE  &kp COMMA  &kp PERIOD  &kp P      &kp Y        &kp F          &kp G   &kp C   &kp R  &kp L
  &kp A             &kp O      &kp E       &kp U      &kp I        &kp D          &kp H   &kp T   &kp N  &kp S
  &to 1             &kp Q      &kp J       &kp K      &kp X        &kp B          &kp M   &kp W   &kp V  &kp Z
                               &kp LC(V)   &kp SPACE  &kp ENTER    &kp BACKSPACE  &trans  &trans
            >;
        };

        numctrl {
            bindings = <
  &kp N1     &kp N2         &kp N3     &kp N4        &kp N5          &kp N6         &kp N7     &kp N8     &kp N9    &kp N0
  &kp LSHFT  &kp TAB        &kp DOT    &to 2         &kp LBKT        &kp RBKT       &kp BSLH   &kp EQUAL  &kp FSLH  &kp RSHFT
  &to 0      &kp LG(LS(S))  &sk LCTRL  &sk LEFT_ALT  &sk LEFT_GUI    &kp ESC        &kp GRAVE  &kp SEMI   &to 0     &kp MINUS
                            &kp LC(V)  &kp SPACE     &kp ENTER       &kp BACKSPACE  &trans     &trans
            >;
        };

        sys {
            bindings = <
  &kp F1  &kp F2   &kp F3   &kp F4   &trans    &trans  &kp INSERT  &kp HOME    &kp PG_UP      &kp CAPS
  &kp F5  &kp F6   &kp F7   &kp F8   &trans    &trans  &kp DELETE  &kp END     &kp PAGE_DOWN  &trans
  &kp F9  &kp F10  &kp F11  &kp F12  &trans    &trans  &trans      &kp SYSREQ  &to 0          &trans
                   &to 0    &to 0    &to 0     &to 0   &trans      &trans
            >;
        };
    };
};